{
  "name": "mcp-server-card-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm --prefix .. run prepare:website-assets && docusaurus start",
    "build": "npm --prefix .. run prepare:website-assets && docusaurus build",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "serialize-javascript": "7.1.4",
    "ws": "8.23.0",
    "uuid": "14.0.3",
    "http-proxy-middleware": "2.0.12",
    "dompurify": "3.4.18",
    "@docusaurus/core": {
      "tinypool": "2.1.2"
    },
    "joi": "17.13.9",
    "follow-redirects": "1.16.2",
    "postcss-selector-parser@^6": "6.1.5",
    "fast-uri": "3.1.9",
    "body-parser": "1.20.9"
  },
  "packageManager": "npm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "core-js@3.49.0": false,
    "fsevents@2.3.3": false
  }
}
