{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/dist-*",
      "!!**/.test-dist",
      "!!**/reports",
      "!!**/coverage",
      "!!**/.next",
      "!!**/build",
      "!!**/.docusaurus",
      "!!**/vendor",
      "!!**/generated",
      "!!**/__snapshots__",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/storybook-static",
      "!**/package-lock.json",
      "!**/pnpm-lock.yaml",
      "!**/examples",
      "!**/fixtures",
      "!**/original-schema",
      "!**/.vscode-test",
      "!**/resources",
      "!**/test-data",
      "!**/testdata",
      "!**/*.css",
      "!**/*.scss",
      "!**/*.html",
      "!**/*.svg",
      "!**/.github/actions/**/dist",
      "!**/example",
      "!**/test-files",
      "!**/resources",
      "!**/schemas",
      "!**/static",
      "!**/res",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml",
      "!**/.github/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": ["**", "!**/.github/**"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "useHookAtTopLevel": "off",
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useSemanticElements": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useButtonType": "warn",
        "useMediaCaption": "warn",
        "noLabelWithoutControl": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noDoubleEquals": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    },
    "globals": [
      "afterAll",
      "afterEach",
      "beforeAll",
      "beforeEach",
      "describe",
      "expect",
      "it",
      "jest",
      "setup",
      "suite",
      "teardown",
      "test"
    ],
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/__mocks__/**",
        "**/test/**",
        "**/tests/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noExportsInTest": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/mock/servers.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnsafeOptionalChaining": "warn"
          },
          "suspicious": {
            "noExportsInTest": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
